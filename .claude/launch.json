{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "registry-workbench",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "ops/tools/run_registry_workbench.py",
        "--port",
        "8010"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010"
    },
    {
      "name": "robotic-ebus-demo",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "ops/tools/run_robotic_ebus_demo.py",
        "--port",
        "8020"
      ],
      "port": 8020,
      "url": "http://127.0.0.1:8020"
    },
    {
      "name": "robotic-ebus-demo-testers",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "ops/tools/run_robotic_ebus_demo.py",
        "--port",
        "8021",
        "--tester-code",
        "local-tester-only"
      ],
      "port": 8021,
      "url": "http://127.0.0.1:8021"
    },
    {
      "name": "robotic-ebus-demo-testers-model",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "ops/tools/run_robotic_ebus_demo.py",
        "--port",
        "8022",
        "--tester-code",
        "local-tester-only",
        "--with-model"
      ],
      "port": 8022,
      "url": "http://127.0.0.1:8022"
    }
  ]
}
